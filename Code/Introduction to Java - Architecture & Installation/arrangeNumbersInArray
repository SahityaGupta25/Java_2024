import java.util.Scanner;

public class Solution {

    public static void arrange(int[] arr, int n) {
        int start = 0;
        int end = n - 1;

        for (int i = 1; i <= n; i++) {
            if (i % 2 != 0) {
                arr[start] = i;
                start++;
            } else {
                arr[end] = i;
                end--;
            }
        }

        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
        System.out.println();
    }

    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int t = s.nextInt();

        for (int i = 0; i < t; i++) {
            int N = s.nextInt();
            int[] arr = new int[N];
            arrange(arr, N);
        }

        s.close();
    }
}
