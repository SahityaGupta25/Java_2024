import java.util.Scanner;
class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        // System.out.println("Enter rows in digit");
        // int x = s.nextInt();
        System.out.println("Enter value of 'n'");
        int n = s.nextInt();
        int i = 1;
        while (i<=n){
            int j = 1;
            while(j<=n){
                System.out.print("*");
                j+=1;
            }
            System.out.println(" ");
            i+=1;
            
            
        }
        
       

        
        
    }
}
